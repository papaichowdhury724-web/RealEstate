# --- Admin panel (REQUIRED in production; there is no default password) ---
ADMIN_PASSWORD=choose-a-strong-password

# --- Option A: local Postgres (used when Firebase keys below are empty) ---
# Create the tables once with:  npm run db:push
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Option B: Firebase (fill ALL of these to switch to Firestore + Storage) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
