rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{file} {
      allow read: if true;
      allow write: if request.resource.size < 80 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
